@using Entities;
@model E_Pago

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    @if (TempData["Error"] != null)
    {
        <p>@TempData["Error"]</p>
    }
    <form asp-controller="Home" asp-action="Procesar" method="post">
        <div>
            <label>Nombre del cliente</label>
        </div>
        <div>
            <input type="text" name="Cliente" />
        </div>
        <div>
            <label>Monto</label>
        </div>
        <div>
            <input type="number" name="Monto" />
        </div>
        <div>
            <label>Selecciona un Metodo de pago</label>
        </div>
        <div>
            <select name="Metodo">
                <option value="Tarjeta">Tarjeta</option>
                <option value="Transferencia">Trasferencia</option>
                <option value="Efectivo">Efectivo</option>
                <option value="Cheque">Cheque</option>
            </select>
        </div>
        <button type="submit">Pagar</button>
    </form>

    @if (Model != null)
    {
        <p>El cliente @Model.Cliente pago por @Model.ObtenerMetodoPago() una comisión correspondiente de: @Model.CalcularComision().ToString("c") por un monto de @Model.Monto</p>
    }
</body>
</html>
